async function boot() {
  try {
    S.env = await getJSON('/api/env');
  } catch (e) {
    $('#bootErr').style.display = 'block';
    $('#bootErrMsg').textContent = String(e.message || e);
    $('#subline').textContent = '本地服务没连上';
    return;
  }
  bindEvents();
  // 不再有「欢迎页 / 主界面」两态。
  //   以前没选目录就先给一页引导，选完才进主界面；现在第一步本身就
  //   是「选机器 + 选路径」，所以直接进主界面，由第一块负责这件事。
  $('#main').style.display = 'block';
  await loadPlace();
  // 每次打开（包括刷新）都从第一步开始，不自动沿用上次的进度。
  //   之前一进来就按服务端记住的运行目录直接跳到"已识别"状态：
  //   刷新后看见的是上次的识别结果、上次答过的闸门，
  //   对使用者来说就是「还没开始怎么已经有一堆结论」。
  //   现在：机器和路径仍然按配置文件预填，但要重新点一次「保存并识别」
  //   才会往下走。刷新 = 干净的开始。
  S.runDir = null;
  S.identified = false;
  S.gates = null;
  S.pipeline = null;
  setStageVisible(false);
  renderPlace();
  renderSidenav();
  renderJargon();
  renderIdentify();
}

