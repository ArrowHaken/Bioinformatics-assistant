                     "（注意：只有带这个约束的节点才看得到原始数据）"))

  # ---- 这一件事到底跑哪条命令：直接给出来，不让执行端自己推 ----
  prof <- flow_profile()
  stepIds <- if (identical(as.character(stepId), "all")) FLOW_ORDER(prof) else as.character(stepId)
  if (identical(as.character(stepId), "config")) {
    L <- c(L, "",
