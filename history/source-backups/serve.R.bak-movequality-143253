    }
    L <- c(L, paste0(k, ". 任何一步失败就停在那一步，把失败原因原样写回，"))
    L <- c(L, "   不许跳过去跑下一步，不许降级、不许抽样顶替、不许自己改参数。")
  }

  # ---- 进度怎么回写：环节级，带时间 ----
