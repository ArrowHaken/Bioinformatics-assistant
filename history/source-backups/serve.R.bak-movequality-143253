get_opt <- function(k, d = NULL) {
  i <- match(k, argv)
  if (is.na(i)) return(d)
  if (i == length(argv) || grepl("^--", argv[i + 1])) return(d)
  argv[i + 1]
}
has_flag <- function(k) k %in% argv

PORT     <- suppressWarnings(as.integer(get_opt("--port", "18980")))
if (is.na(PORT)) PORT <- 18980L
AUTOOPEN <- !has_flag("--no-open")
