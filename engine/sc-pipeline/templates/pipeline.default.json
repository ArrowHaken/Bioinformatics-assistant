  "steps": {
    "read_exclusion": {
      "mode": "none",
      "samples": [],
      "source": "gate",
      "reason": "读入前剔除整样本。仅在明确了要剔哪个样本时才用。"
    },
    "cluster_filter": {
      "mode": "none",
      "by_name_keep": [],
      "mapping_file": null,
      "source": "gate",
      "reason": "筛群。默认不剔除。若确需剔除，优先按细胞类型名（换数据安全）；按簇号仅限本次有效，且必须在 reason 里写明。"
    },
    "post_cluster_exclusion": {
      "mode": "none",
      "samples": [],
      "source": "gate",
      "reason": "聚类后剔除样本。样本名必须来自首样本结果，不许预先写死。"
    },
    "lowconfidence": {
      "mode": "flag_only",
      "min_cells": 200,
      "source": "gate",
      "reason": "细胞数低于 min_cells 的簇标记为低置信，不强行命名。"
    },
    "memory": {
      "mode": "auto",
      "blocked_when_insufficient": true,
      "source": "instance",
