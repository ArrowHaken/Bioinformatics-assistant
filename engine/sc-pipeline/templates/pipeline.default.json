  "params": {
    "species": { "value": "Mouse", "source": "official", "locked": true, "why": "本批数据全 Mouse" },
    "nfeatures": { "value": 2000, "source": "official", "locked": true, "why": "" },
    "dims": { "value": 20, "source": "official", "locked": true, "why": "" },
    "pcs_doublet": { "value": 20, "source": "official", "locked": true, "why": "" },
