    "qc_min_features": { "value": null, "source": "gate", "why": "官方数据实测最小 401，但脚本写 300、PPT 写 400、注释写 500。必须确认。" },
    "qc_max_features": { "value": 5000, "source": "official", "locked": false, "why": "" },
    "qc_mt": { "value": 10, "source": "official", "locked": false, "why": "" },
    "res1": { "value": 0.5, "source": "official", "locked": false, "why": "" },
    "res2": { "value": 0.6, "source": "official", "locked": false, "why": "" },
